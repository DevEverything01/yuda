[Unit]
Description=Yuda Chinese-first voice input daemon
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/yuda --daemon
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info
PassEnvironment=WAYLAND_DISPLAY WAYLAND_SOCKET XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS

[Install]
WantedBy=default.target
