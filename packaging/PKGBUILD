# Maintainer: Yuda contributors
pkgname=yuda-git
pkgver=r1
pkgrel=1
pkgdesc='中文优先的 Wayland 语音输入 daemon'
arch=('x86_64' 'aarch64')
url='https://github.com/yuda-ime/yuda'
license=('MIT')
depends=('wl-clipboard' 'wtype' 'pipewire')
optdepends=('ydotool: Ctrl+V fallback')
makedepends=('git' 'rust')
source=('git+https://github.com/example/yuda.git')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/yuda"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/yuda"
  cargo build --release --locked
}

package() {
  cd "$srcdir/yuda"
  install -Dm755 target/release/yuda "$pkgdir/usr/bin/yuda"
  install -Dm644 packaging/yuda.service "$pkgdir/usr/lib/systemd/user/yuda.service"
  install -Dm644 examples/config.example.toml "$pkgdir/usr/share/yuda/config.example.toml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/yuda/LICENSE"
}
