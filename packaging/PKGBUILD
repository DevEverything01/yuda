# Maintainer: Yuda contributors
pkgname=yuda-git
pkgver=r1
pkgrel=1
pkgdesc='语打：Omarchy 上对标豆包输入法的中文语音输入（听写后端 + shell 插件）'
arch=('x86_64' 'aarch64')
url='https://github.com/DevEverything01/yuda'
license=('MIT')
depends=('wl-clipboard' 'pipewire' 'alsa-lib' 'gcc-libs')
optdepends=(
  'wtype: Hyprland 之外的粘贴后端'
  'ydotool: 最后的粘贴后端'
  'omarchy: 通过 omarchy-install-dictation-yuda 接入 Omarchy 听写快捷键与菜单'
)
makedepends=('git' 'rust' 'clang' 'cmake')
provides=('yuda')
conflicts=('yuda')
install=yuda.install
source=('git+https://github.com/DevEverything01/yuda.git')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/yuda"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/yuda"
  export CARGO_TARGET_DIR=target
  cargo build --release --locked --features daemon
}

check() {
  cd "$srcdir/yuda"
  cargo test --release --locked --features daemon
}

package() {
  cd "$srcdir/yuda"
  make install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/yuda/README.md"
}
